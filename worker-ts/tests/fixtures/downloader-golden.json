{
  "constants": {
    "youtube_format_selector": "bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720][ext=mp4]/bestvideo[height<=720]+bestaudio/best[height<=720]/best",
    "youtube_js_runtimes": [
      "deno",
      "node",
      "quickjs",
      "bun"
    ],
    "platform_subtitle_args": [
      "--write-subs",
      "--write-auto-subs",
      "--sub-langs",
      "zh-Hans,zh-CN,zh-Hant,zh,en,ja,ko",
      "--sub-format",
      "best"
    ],
    "youtube_hosts": [
      "youtube.com",
      "www.youtube.com",
      "m.youtube.com"
    ],
    "youtube_short_hosts": [
      "youtu.be",
      "www.youtu.be"
    ],
    "douyin_host_suffixes": [
      "douyin.com",
      "iesdouyin.com"
    ],
    "xiaohongshu_host_suffixes": [
      "xiaohongshu.com",
      "xhslink.com",
      "xhslink.cn"
    ],
    "bilibili_host_suffixes": [
      "bilibili.com",
      "b23.tv"
    ],
    "downloaded_media_suffixes": [
      ".mp4",
      ".mkv",
      ".webm",
      ".mov",
      ".m4v"
    ],
    "ytdlp_timeout_seconds": 1200,
    "ytdlp_timeout_code": "VIDEO_DOWNLOAD_TIMEOUT",
    "url_trailing_punctuation": " \t\r\n\"'<>[]{}()，。！？；：、,.;:!?",
    "youtube_video_id_pattern": "^[A-Za-z0-9_-]+$"
  },
